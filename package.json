{
  "name": "inbora",
  "version": "0.3.5",
  "private": true,
  "type": "module",
  "description": "Single-account, approval-gated Douyin web PoC",
  "bin": {
    "inbora": "dist/cli.js"
  },
  "engines": {
    "node": ">=24.22.1 <25 || >=26.13.0 <27",
    "pnpm": "11.25.0"
  },
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "inbora": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit && tsc -p desktop/tsconfig.json",
    "test": "vitest run tests/unit && vitest run --config desktop/vite.config.ts desktop/src",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "vitest run tests/e2e",
    "test:built": "pnpm build && node scripts/browser-smoke.mjs && node scripts/observed-smoke.mjs && node scripts/dm-reply-smoke.mjs && node scripts/comment-reply-smoke.mjs && node scripts/submission-smoke.mjs && node scripts/inbox-sync-smoke.mjs && node scripts/automation-smoke.mjs && node scripts/media-pause-smoke.mjs && node scripts/emergency-guard-smoke.mjs",
    "test:real": "tsx src/cli.ts real-test",
    "build": "tsc -p tsconfig.build.json",
    "check:privacy": "node scripts/check-privacy.mjs",
    "desktop:dev:web": "vite --config desktop/vite.config.ts",
    "desktop:build:web": "vite build --config desktop/vite.config.ts",
    "desktop:prepare": "pnpm build && pnpm desktop:build:web && node scripts/stage-sidecar.mjs && node scripts/rust-notices.mjs",
    "desktop:dev": "node scripts/desktop-build.mjs --dev",
    "desktop:build": "node scripts/desktop-build.mjs",
    "check:source-size": "node scripts/check-source-size.mjs"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.105",
    "@ai-sdk/deepseek": "3.0.87",
    "@ai-sdk/google": "4.0.121",
    "@ai-sdk/openai": "4.0.118",
    "@ai-sdk/openai-compatible": "3.0.92",
    "@base-ui/react": "1.9.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "5.3.0",
    "@modelcontextprotocol/server": "2.4.0",
    "@tauri-apps/api": "2.12.4",
    "ai": "7.0.173",
    "better-sqlite3": "13.0.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "exceljs": "4.4.0",
    "lucide-react": "0.555.0",
    "mammoth": "1.13.0",
    "misans": "5.0.0",
    "pdfjs-dist": "6.5.438",
    "pino": "10.4.0",
    "playwright": "1.64.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.5",
    "@tauri-apps/cli": "2.12.4",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
